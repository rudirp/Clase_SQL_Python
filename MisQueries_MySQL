-- 1. Definir que BBDD vamos a usar

USE sakila;

-- 2. Seleccionar datos de tabla
-- * equivale a todo (filas o columnas)

-- Tabla
SELECT * FROM city;

-- Vistas
SELECT * FROM actor_info;

-- Seleccionar columnas específicas
SELECT
	title,
	special_features
FROM film;
    
-- 3. Limite de filas

SELECT*FROM film
LIMIT 25;

SELECT 
	film_id,
    title,
    rental_duration
FROM film
LIMIT 25;

-- 4. Uso de alias
SELECT
	title AS nombre_pelicula,
    description AS descripcion_pelicula,
    release_year AS ano
FROM film;

-- 5. Filtrar datos
SELECT * FROM Film
WHERE length = 50; -- Quiero que salga solo los que tengan dato 50

SELECT * FROM Film
WHERE length != 50; -- No quiero que salga los que tengan dato 50

SELECT * FROM Film
WHERE length <> 50; -- No quiero que salga los que tengan dato 50

SELECT * FROM Film
WHERE title = 'ACADEMY DINOSAUR'; -- Quiero que salga solo ACADEMY DINOSAUR

SELECT * FROM Film
WHERE title != 'ACADEMY DINOSAUR'; -- No quiero que salga solo ACADEMY DINOSAUR

-- 6.Filtro de texto:  Wildcard (%) - Busqueda de texto

SELECT * FROM film_text
WHERE DESCRIPTION = "CAT"; -- Busqueda un texto exacto

-- a. Inicio del texto
SELECT * FROM film_text
WHERE DESCRIPTION LIKE "%CAT"; -- Texto a la izquierda puede ser cualquier cosa

-- b. Final del texto
SELECT * FROM film_text
WHERE DESCRIPTION LIKE "CAT%"; -- Texto a la derecha puede ser cualquier cosa

-- c. En el texto
SELECT * FROM film_text
WHERE DESCRIPTION LIKE "%CAT%"; -- Texto a la derecha o izquierda puede ser cualquier cosa

-- d. And 
SELECT * FROM film_text
WHERE DESCRIPTION LIKE "%CAT%" AND DESCRIPTION LIKE "%FEMINIST%"; -- Las 2 condiciones se tiene que cumplir

-- d. OR  
SELECT * FROM film_text
WHERE DESCRIPTION LIKE "%CAT%" OR DESCRIPTION LIKE "%FEMINIST%"; -- Basta que 1 condición se cumpla

-- 7. Varios filtros

SELECT * FROM film
WHERE  title  IN ("ACADEMY DINOSAUR", "WHALE BIKINI"); -- Cuando buscas litas, se usa IN 

SELECT * FROM film
WHERE  title  NOT IN ("ACADEMY DINOSAUR", "WHALE BIKINI"); -- Cuando buscas litas, se usa IN 

SELECT * FROM customer
WHERE first_name NOT IN ('MARY', 'PATRICIA')
AND address_id <20;

SELECT * FROM film
WHERE  title  NOT IN ("ACADEMY_DINOSAUR", "WHALE_BIKINI")
AND description LIKE "%Squirrel%"
AND special_features LIKE "%Deleted_Scenes%"
AND length < 90
AND rental_rate BETWEEN 2.99 AND 4.99; 

-- 8. Ordenar datos
-- ASC (Ascendente): Menor a mayor
-- DESC (Descendente): Mayor a menor

SELECT * FROM Customer
ORDER BY email ASC;

SELECT * FROM Customer
ORDER BY email DESC;

SELECT * FROM actor
ORDER BY last_name, first_name; 

SELECT * FROM actor
ORDER BY last_name, first_name DESC;

SELECT * FROM film
WHERE  title  NOT IN ("ACADEMY_DINOSAUR", "WHALE_BIKINI")
AND description LIKE "%Squirrel%"
AND special_features LIKE "%Deleted_Scenes%"
AND length < 90
AND rental_rate BETWEEN 2.99 AND 4.99
ORDER BY title, description;


-- 9. Condicionales (IF). Usalmente las condicionales te permiten crear nuevas columnas

SELECT 
	*,
    IF(special_features LIKE "%Trailers%", "Yes", "No") AS trailers,
    IF(special_features LIKE "%Comentaries%", "Yes", "No") AS Comentaries,
    IF(special_features LIKE "%Deleted Scenes%", "Yes", "No") AS Deleted_Scenes,
    IF(special_features LIKE "%Behind the scenes%", "Yes", "No") AS Behind_the_scenes
FROM film;

SELECT
	*,
    CASE WHEN special_features LIKE "%Trailers%" THEN 'Yes' ELSE 'NO' END AS trailers,
    CASE WHEN special_features LIKE "%Comentaries%" THEN 'Yes' ELSE 'NO' END AS Comentaries,
    CASE WHEN special_features LIKE "%Deleted Scenes%" THEN 'Yes' ELSE 'NO' END AS Deleted_Scenes,
    CASE WHEN special_features LIKE "%Behind the scenes%" THEN 'Yes' ELSE 'NO' END AS Behind_the_scenes
FROM film;


-- 10. Varias condiciones

SELECT
	length, -- Acá indicas la columna a trabajar, si pones (*) trabajas con todo
    CASE 
		WHEN length<60 THEN '000-060' -- Condicion 1
		WHEN length>60 AND length<=120 THEN '000-120' -- Condicion 2
		WHEN length>120 AND length<=180 THEN '120-180' -- Condicion 3
		ELSE 'Otro' END AS rango_length
FROM film;
  
  
-- EXTRA: Query completo
SELECT 
	*,
    IF(special_features LIKE "%Trailers%", "Yes", "No") AS trailers,
    IF(special_features LIKE "%Comentaries%", "Yes", "No") AS Comentaries,
    IF(special_features LIKE "%Deleted Scenes%", "Yes", "No") AS Deleted_Scenes,
    IF(special_features LIKE "%Behind the scenes%", "Yes", "No") AS Behind_the_scenes,
	CASE 
		WHEN length<60 THEN '000-060' -- Condicion 1
		WHEN length>60 AND length<=120 THEN '000-120' -- Condicion 2
		WHEN length>120 AND length<=180 THEN '120-180' -- Condicion 3
		ELSE 'Otro' END AS rango_length
FROM film
WHERE  title  NOT IN ("ACADEMY_DINOSAUR", "WHALE_BIKINI")
AND description LIKE "%Squirrel%"
AND special_features LIKE "%Deleted_Scenes%"
AND length < 90
AND rental_rate BETWEEN 2.99 AND 4.99
ORDER BY title, description;

-- 11. Agrupaciones y agregaciones

SELECT * FROM film;
-- ¿Cuantas peliculas hay por cada valor de rental_duration y rental_rate?

-- Opc 1: Si quieres contar valores existentes en una columna específica
SELECT
	rental_duration,
    COUNT(film_id) AS films
FROM film
GROUP BY rental_duration;

-- Opc2: Si solo quieres contar filas
SELECT
	rental_duration,
    COUNT(*)AS films
FROM film
GROUP BY rental_duration
ORDER BY rental_duration;

-- Dos agregaciones
SELECT
	rating,
    rental_duration,
    count(film_id) AS Cantidad
FROM film
GROUP BY rating, rental_duration
ORDER BY rental_duration;


